generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EstadoProceso {
  PENDIENTE
  COMPLETADO
}

enum EstadoPaso {
  PENDIENTE
  COMPLETADO
}

enum UserRole {
  ADMINISTRADOR
  GESTOR
  LECTOR
  AYUDANTE
}

model ProcessCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique // Ej: "Evaluación Docente", "Gestión Académica"
  description String?
  isActive    Boolean  @default(true)

  // Quién creó la categoría
  createdById Int?
  createdBy   User? @relation("UserCreatedCategories", fields: [createdById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  processTypes ProcessType[]
}

model ProcessType {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  isActive    Boolean @default(true)

  // Relación con categoría
  categoryId Int
  category   ProcessCategory @relation(fields: [categoryId], references: [id])

  // Quién creó el tipo de proceso
  createdById Int?
  createdBy   User? @relation("UserCreatedProcessTypes", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templates        ProcessTemplate[]
  processInstances ProcessInstance[]
}

model ProcessTemplate {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  isActive    Boolean @default(true)

  processTypeId Int
  processType   ProcessType @relation(fields: [processTypeId], references: [id])

  // Quién creó la plantilla
  createdById Int?
  createdBy   User? @relation("UserCreatedTemplates", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps            ProcessTemplateStep[]
  // Instancias creadas a partir de esta plantilla
  processInstances ProcessInstance[]
}

model ProcessTemplateStep {
  id         Int             @id @default(autoincrement())
  templateId Int
  template   ProcessTemplate @relation(fields: [templateId], references: [id])

  order       Int // 1, 2, 3...
  name        String
  description String?

  responsibleRole  String? // p.ej. "PROFESOR", "SECRETARIA", "DECANO"
  dueDaysFromStart Int? // días después del inicio del proceso
  isMandatory      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Pasos concretos de procesos reales
  stepInstances StepInstance[]
}

model ProcessInstance {
  id    Int    @id @default(autoincrement())
  title String // nombre visible del proceso, ej: "Evaluación Docente 2025-I"

  // Estado en español
  estado EstadoProceso @default(PENDIENTE)

  // De qué tipo y plantilla viene
  processTypeId Int
  processType   ProcessType @relation(fields: [processTypeId], references: [id])

  templateId Int
  template   ProcessTemplate @relation(fields: [templateId], references: [id])

  // Quién creó el proceso (diferente de responsable)
  createdById Int?
  createdBy   User? @relation("UserCreatedProcessInstances", fields: [createdById], references: [id])

  // Responsable del proceso (quien lo gestiona actualmente)
  responsibleUserId Int?
  responsibleUser   User? @relation("UserProcessInstances", fields: [responsibleUserId], references: [id])

  year        Int?
  month       Int?
  comment     String?
  dueAt       DateTime? // fecha límite global del proceso
  completedAt DateTime? // cuándo se completó todo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Pasos concretos del proceso
  steps StepInstance[]
}

model StepInstance {
  id    Int    @id @default(autoincrement())
  title String // nombre del paso en esta instancia (copiado de la plantilla)

  // Estado en español
  estado EstadoPaso @default(PENDIENTE)

  comment String? // observación del usuario si quieres

  processInstanceId Int
  processInstance   ProcessInstance @relation(fields: [processInstanceId], references: [id])

  templateStepId Int
  templateStep   ProcessTemplateStep @relation(fields: [templateStepId], references: [id])

  dueAt       DateTime? // fecha límite de este paso
  completedAt DateTime? // cuándo se subió el archivo y se dio por completado

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files StepFile[]
}

model StepFile {
  id Int @id @default(autoincrement())

  stepId Int
  step   StepInstance @relation(fields: [stepId], references: [id], onDelete: Cascade)

  originalName String
  mimeType     String
  sizeBytes    Int
  version      Int
  
  // Almacenamiento en R2
  storageKey   String    // Key única en Cloudflare R2 (obligatorio ahora)
  content      Bytes?    // Opcional - solo para compatibilidad/migración

  uploadedById Int?
  uploadedBy   User? @relation("UserStepFiles", fields: [uploadedById], references: [id])

  uploadedAt DateTime @default(now())

  @@unique([stepId, version])
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String // hash bcrypt
  fullName String
  role     UserRole @default(LECTOR)
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones de gestión
  processInstances ProcessInstance[] @relation("UserProcessInstances")
  uploadedFiles    StepFile[]        @relation("UserStepFiles")
  
  // Relaciones de creación (quién creó qué)
  createdCategories       ProcessCategory[]  @relation("UserCreatedCategories")
  createdProcessTypes     ProcessType[]      @relation("UserCreatedProcessTypes")
  createdTemplates        ProcessTemplate[]  @relation("UserCreatedTemplates")
  createdProcessInstances ProcessInstance[]  @relation("UserCreatedProcessInstances")
  
  // Bitácora
  auditLogs AuditLog[] @relation("UserAuditLogs")
}

// Bitácora - Registro de todas las acciones del sistema
model AuditLog {
  id Int @id @default(autoincrement())

  // Tipo de acción: CREATE, UPDATE, DELETE, LOGIN, LOGOUT, UPLOAD, DOWNLOAD, ASSIGN, UNASSIGN
  action String

  // Tipo de entidad afectada: USER, PROCESS_TYPE, PROCESS_TEMPLATE, PROCESS_INSTANCE, STEP, FILE, etc.
  entityType String

  // ID de la entidad afectada (opcional, puede ser null para acciones como login)
  entityId Int?

  // Descripción legible de la acción
  description String

  // Detalles adicionales en formato JSON (opcional)
  details String? // JSON stringificado con datos adicionales

  // Usuario que realizó la acción
  userId Int?
  user   User? @relation("UserAuditLogs", fields: [userId], references: [id])

  // IP del usuario (opcional)
  ipAddress String?

  // Fecha y hora de la acción
  createdAt DateTime @default(now())

  // Índices para búsquedas eficientes
  @@index([action])
  @@index([entityType])
  @@index([userId])
  @@index([createdAt])
}
